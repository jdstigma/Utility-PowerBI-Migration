	partition 'AMI Daily' = m
		mode: import
		source =
				let
				    Source = Parquet.Document(Binary.Buffer(Web.Contents(BaseUrl, [RelativePath = "ami_daily_profile.parquet"]))),
				    Typed = Table.TransformColumnTypes(Source, {{"read_date", type date}, {"division", type text}, {"elec_rate_code", type text}, {"meters_expected", Int64.Type}, {"meters_reporting", Int64.Type}, {"reads_estimated", Int64.Type}, {"reads_spike", Int64.Type}, {"kwh_valid", type number}, {"reads_valid", Int64.Type}, {"max_peak_kw", type number}})
