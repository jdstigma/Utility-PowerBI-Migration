table 'AMI Daily'
	lineageTag: 54803fb7-e28e-f05a-9733-9cc496b03630

	measure 'Avg Daily kWh per Meter' = DIVIDE(SUM('AMI Daily'[kwh_valid]), SUM('AMI Daily'[reads_valid]))
		formatString: #,0.0
		displayFolder: AMI
		lineageTag: fc82a580-f289-3715-286a-299903670c48

	measure 'Read Success %' = DIVIDE(SUM('AMI Daily'[meters_reporting]), SUM('AMI Daily'[meters_expected]))
		formatString: 0.00%
		displayFolder: AMI
		lineageTag: a3678f37-964b-3a81-9183-1c9ef9607d0a

	measure 'Estimated Read %' = DIVIDE(SUM('AMI Daily'[reads_estimated]), SUM('AMI Daily'[meters_expected]))
		formatString: 0.00%
		displayFolder: AMI
		lineageTag: 300cd5c9-5fdf-3f93-f12b-ad42db032980

	measure 'Spike Reads' = SUM('AMI Daily'[reads_spike])
		formatString: #,0
		displayFolder: AMI
		lineageTag: 2fb529f2-7bab-2c04-58c9-af9f4174e459

