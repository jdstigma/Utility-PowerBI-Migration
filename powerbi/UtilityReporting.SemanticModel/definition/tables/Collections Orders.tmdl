	partition 'Collections Orders' = m
		mode: import
		source =
				let
				    Source = Parquet.Document(Binary.Buffer(Web.Contents(BaseUrl, [RelativePath = "collections_orders_monthly.parquet"]))),
				    Typed = Table.TransformColumnTypes(Source, {{"created_month", type date}, {"order_type", type text}, {"status", type text}, {"division", type text}, {"segment", type text}, {"is_low_income", type logical}, {"orders", Int64.Type}, {"completed_within_1_day", Int64.Type}, {"avg_cycle_days", type number}})
