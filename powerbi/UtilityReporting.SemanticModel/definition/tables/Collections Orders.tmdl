table 'Collections Orders'
	lineageTag: 3147cf91-db7c-a32b-1f38-d8de29119bd3

	measure Disconnects = CALCULATE(SUM('Collections Orders'[orders]), 'Collections Orders'[order_type] = "Disconnect for Non-Pay", 'Collections Orders'[status] = "Completed")
		formatString: #,0
		displayFolder: Collections
		lineageTag: fd6036f9-1f2e-d0c3-2b67-97742324a181

	measure Reconnects = CALCULATE(SUM('Collections Orders'[orders]), 'Collections Orders'[order_type] = "Reconnect", 'Collections Orders'[status] = "Completed")
		formatString: #,0
		displayFolder: Collections
		lineageTag: bce5d2f8-aa46-06d5-6caf-456473019ddf

	measure 'Reconnect Rate %' = DIVIDE([Reconnects], [Disconnects])
		formatString: 0.0%
		displayFolder: Collections
		lineageTag: 977ad06f-3448-fce7-3904-3bab106d8dac

	measure 'Reconnect Within 1 Day %' = DIVIDE(CALCULATE(SUM('Collections Orders'[completed_within_1_day]), 'Collections Orders'[order_type] = "Reconnect", 'Collections Orders'[status] = "Completed"), [Reconnects])
		formatString: 0.0%
		displayFolder: Collections
		lineageTag: 508c43e3-b4b6-7e5f-9e96-9062bd6ff5dd

