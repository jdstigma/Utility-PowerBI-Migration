	partition 'Revenue Commercial' = m
		mode: import
		source =
				let
				    Source = Parquet.Document(Binary.Buffer(Web.Contents(BaseUrl, [RelativePath = "revenue_commercial_monthly.parquet"]))),
				    Typed = Table.TransformColumnTypes(Source, {{"period_key", Int64.Type}, {"bill_month", type date}, {"customer_class", type text}, {"division", type text}, {"segment", type text}, {"elec_rate_code", type text}, {"gas_rate_code", type text}, {"elec_supplier", type text}, {"bills", Int64.Type}, {"customers_billed", Int64.Type}, {"kwh", type number}, {"therms", type number}, {"elec_delivery_amt", type number}, {"elec_supply_amt", type number}, {"gas_delivery_amt", type number}, {"gas_supply_amt", type number}, {"tax_amt", type number}, {"total_amt", type number}})
				in
				    Typed

	annotation PBI_ResultType = Table

