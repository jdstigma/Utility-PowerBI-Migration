table 'Revenue Commercial'
	lineageTag: 388519a4-24a6-99e2-baaa-9495d7f85b49

	measure 'C&I Revenue' = SUM('Revenue Commercial'[total_amt])
		formatString: \$#,0
		displayFolder: Revenue
		lineageTag: 83f5e7a8-5f42-495a-2e2d-b8996464b2c2

	measure 'C&I kWh' = SUM('Revenue Commercial'[kwh])
		formatString: #,0
		displayFolder: Usage
		lineageTag: 7bfb2ebb-69d8-8ee1-653a-d739eecdbb6a

	measure 'C&I Therms' = SUM('Revenue Commercial'[therms])
		formatString: #,0
		displayFolder: Usage
		lineageTag: 653b6c63-db97-f73e-ed09-54c6e1710b92

	measure 'C&I Bills' = SUM('Revenue Commercial'[bills])
		formatString: #,0
		displayFolder: Revenue
		lineageTag: 6d294140-dfc5-381a-c64f-fbe3a14bf8c7

	measure 'Avg C&I Bill' = DIVIDE([C&I Revenue], [C&I Bills])
		formatString: \$#,0.00
		displayFolder: Revenue
		lineageTag: 64bd71a8-e909-48b7-9cc6-3bf60011c19b

	measure 'C&I Revenue YoY %' = VAR firstKey = MINX(ALL('Period'), 'Period'[period_key]) VAR keys = FILTER(VALUES('Period'[period_key]), 'Period'[period_key] - 100 >= firstKey) VAR cur = CALCULATE([C&I Revenue], TREATAS(keys, 'Period'[period_key])) VAR py = CALCULATE([C&I Revenue], REMOVEFILTERS('Period'), TREATAS(SELECTCOLUMNS(keys, "k", 'Period'[period_key] - 100), 'Period'[period_key])) RETURN IF(NOT ISBLANK(py), DIVIDE(cur - py, py))
		formatString: 0.0%
		displayFolder: Revenue
		lineageTag: 86ed1f5b-2aea-981c-aa69-9f4659accdb9

