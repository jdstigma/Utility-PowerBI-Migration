	partition 'Digital Adoption' = m
		mode: import
		source =
				let
				    Source = Parquet.Document(Binary.Buffer(Web.Contents(BaseUrl, [RelativePath = "digital_adoption_monthly.parquet"]))),
				    Typed = Table.TransformColumnTypes(Source, {{"month_end", type date}, {"segment", type text}, {"division", type text}, {"active_customers", Int64.Type}, {"autopay_customers", Int64.Type}, {"paperless_customers", Int64.Type}})
				in
				    Typed

	annotation PBI_ResultType = Table

