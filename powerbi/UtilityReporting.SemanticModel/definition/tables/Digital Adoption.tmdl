table 'Digital Adoption'
	lineageTag: a3079c3e-2284-b606-be5f-3b3b6c84f92b

	measure 'Active Customers' = VAR me = MAX('Digital Adoption'[month_end]) RETURN CALCULATE(SUM('Digital Adoption'[active_customers]), 'Digital Adoption'[month_end] = me)
		formatString: #,0
		displayFolder: Adoption
		lineageTag: 30243f06-459d-cb4e-969a-ca19e6eb6eb8

	measure 'Autopay %' = DIVIDE(VAR me = MAX('Digital Adoption'[month_end]) RETURN CALCULATE(SUM('Digital Adoption'[autopay_customers]), 'Digital Adoption'[month_end] = me), [Active Customers])
		formatString: 0.0%
		displayFolder: Adoption
		lineageTag: d7aadcd2-3f76-2ca4-624a-b4d153b51d68

	measure 'Paperless %' = DIVIDE(VAR me = MAX('Digital Adoption'[month_end]) RETURN CALCULATE(SUM('Digital Adoption'[paperless_customers]), 'Digital Adoption'[month_end] = me), [Active Customers])
		formatString: 0.0%
		displayFolder: Adoption
		lineageTag: e2b3e8be-24a9-8e2a-2e1f-824ce708e43f

	column month_end
		dataType: dateTime
		formatString: Short Date
		lineageTag: 21f78c5b-5827-be5c-d82b-ab97f6ca9bcc
		summarizeBy: none
		sourceColumn: month_end

		annotation SummarizationSetBy = Automatic

	column segment
