		summarizeBy: none
		sourceColumn: division

		annotation SummarizationSetBy = Automatic

	column active_customers
		dataType: int64
		formatString: #,0
		lineageTag: 9d5c224b-d3ec-bfb3-b592-a3ed745158b1
		summarizeBy: sum
		sourceColumn: active_customers

		annotation SummarizationSetBy = Automatic

	column autopay_customers
		dataType: int64
		formatString: #,0
		lineageTag: 3d6b8c0d-97e5-f5f1-5523-ecc61b83006e
