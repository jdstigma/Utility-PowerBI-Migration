	partition 'Payment Plans' = m
		mode: import
		source =
				let
				    Source = Parquet.Document(Binary.Buffer(Web.Contents(BaseUrl, [RelativePath = "payment_plans_monthly.parquet"]))),
				    Typed = Table.TransformColumnTypes(Source, {{"created_month", type date}, {"plan_type", type text}, {"status", type text}, {"segment", type text}, {"division", type text}, {"is_low_income", type logical}, {"plans", Int64.Type}, {"total_amt", type number}, {"down_payment", type number}, {"avg_installments", type number}})
				in
				    Typed

	annotation PBI_ResultType = Table

