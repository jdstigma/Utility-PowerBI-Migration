table 'Payment Plans'
	lineageTag: 9444da82-b560-5524-4af4-aae1253ca56a

	measure 'Payment Plans Created' = SUM('Payment Plans'[plans])
		formatString: #,0
		displayFolder: Collections
		lineageTag: bf7c247b-7395-1dd5-ecd6-847fd1ea56d7

	measure 'Plan Default %' = DIVIDE(CALCULATE(SUM('Payment Plans'[plans]), 'Payment Plans'[status] = "Defaulted"), CALCULATE(SUM('Payment Plans'[plans]), 'Payment Plans'[status] IN {"Completed", "Defaulted"}))
		formatString: 0.0%
		displayFolder: Collections
		lineageTag: 7fc4839b-a989-0bf7-8bd2-ee955e1031d5

