	partition 'Contact Center' = m
		mode: import
		source =
				let
				    Source = Parquet.Document(Binary.Buffer(Web.Contents(BaseUrl, [RelativePath = "contact_center_daily.parquet"]))),
				    Typed = Table.TransformColumnTypes(Source, {{"interaction_date", type date}, {"channel", type text}, {"reason", type text}, {"site", type text}, {"is_assisted", type logical}, {"contacts", Int64.Type}, {"identified_contacts", Int64.Type}, {"wait_sec_total", Int64.Type}, {"answered_within_30s", Int64.Type}, {"agent_calls", Int64.Type}, {"handle_sec_total", Int64.Type}, {"resolved_first_contact", Int64.Type}, {"transferred", Int64.Type}, {"csat_responses", Int64.Type}, {"csat_total", type number}, {"csat_satisfied", Int64.Type}})
				in
				    Typed

	annotation PBI_ResultType = Table

