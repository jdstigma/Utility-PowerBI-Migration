table Outages
	lineageTag: b0456fd2-b666-3ca8-7a0a-df9f88206b33

	measure 'Outage Events' = COUNTROWS(Outages)
		formatString: #,0
		displayFolder: Reliability
		lineageTag: 7c280251-ec64-dc63-c1c4-98a2acc5b445

	measure 'Customer Minutes' = SUM(Outages[customer_minutes])
		formatString: #,0
		displayFolder: Reliability
		lineageTag: 1070bfd3-b2f7-8319-c355-36f048844d78

	measure 'Customer Interruptions' = SUM(Outages[customers_out])
		formatString: #,0
		displayFolder: Reliability
		lineageTag: e157a3a3-7f27-d9de-7191-5f65211df720

	measure 'SAIDI (min)' = DIVIDE([Customer Minutes], [Customers Served])
		formatString: #,0.0
		displayFolder: Reliability
		lineageTag: b497feec-816b-3be8-6771-f25d62d9bb1b

	measure SAIFI = DIVIDE([Customer Interruptions], [Customers Served])
		formatString: #,0.00
		displayFolder: Reliability
		lineageTag: 41aed30a-4b55-06c0-d378-b90391595b61

	measure 'CAIDI (min)' = DIVIDE([Customer Minutes], [Customer Interruptions])
		formatString: #,0.0
		displayFolder: Reliability
		lineageTag: 482151f1-9bc7-bb3a-79ee-8260c0aa5575

	measure 'SAIDI excl. MED (min)' = CALCULATE([SAIDI (min)], Outages[is_major_event_day] = FALSE())
		formatString: #,0.0
		displayFolder: Reliability
		lineageTag: 045f50ef-b567-e530-ba6e-f949a78f7655

	measure 'SAIFI excl. MED' = CALCULATE([SAIFI], Outages[is_major_event_day] = FALSE())
		formatString: #,0.00
		displayFolder: Reliability
		lineageTag: 4436b91c-980c-eee8-5abd-e39d70f636d4

