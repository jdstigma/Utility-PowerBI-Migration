	partition Outages = m
		mode: import
		source =
				let
				    Source = Parquet.Document(Binary.Buffer(Web.Contents(BaseUrl, [RelativePath = "reliability_events.parquet"]))),
				    Typed = Table.TransformColumnTypes(Source, {{"outage_id", Int64.Type}, {"outage_start", type datetime}, {"restore_time", type datetime}, {"outage_date", type date}, {"duration_min", type number}, {"is_open", type logical}, {"division", type text}, {"municipality", type text}, {"circuit_id", type text}, {"device_type", type text}, {"cause", type text}, {"customers_out", Int64.Type}, {"customer_minutes", type number}, {"is_major_event_day", type logical}})
				in
				    Typed

	annotation PBI_ResultType = Table

