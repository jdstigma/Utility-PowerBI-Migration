	partition 'AR Aging' = m
		mode: import
		source =
				let
				    Source = Parquet.Document(Binary.Buffer(Web.Contents(BaseUrl, [RelativePath = "ar_aging_monthly.parquet"]))),
				    Typed = Table.TransformColumnTypes(Source, {{"month_end", type date}, {"segment", type text}, {"division", type text}, {"aging_bucket", type text}, {"bucket_order", Int64.Type}, {"is_receivable", type logical}, {"open_amt", type number}, {"open_bills", Int64.Type}, {"open_accounts", Int64.Type}})
				in
