table 'AR Aging'
	lineageTag: be99bd9b-e2f6-204e-18d9-be098b1cec84

	measure 'AR Balance' = VAR me = MAX('AR Aging'[month_end]) RETURN CALCULATE(SUM('AR Aging'[open_amt]), 'AR Aging'[month_end] = me, 'AR Aging'[is_receivable] = TRUE())
		formatString: \$#,0
		displayFolder: AR
		lineageTag: 046c2ef7-4ed8-bd73-62ae-68799e78fc69

	measure 'AR Past Due' = VAR me = MAX('AR Aging'[month_end]) RETURN CALCULATE(SUM('AR Aging'[open_amt]), 'AR Aging'[month_end] = me, 'AR Aging'[is_receivable] = TRUE(), 'AR Aging'[bucket_order] > 1)
		formatString: \$#,0
		displayFolder: AR
		lineageTag: 1d2f20bf-b2b5-22d8-29eb-ba8718f6aba6

	measure 'AR % Past Due' = DIVIDE([AR Past Due], [AR Balance])
		formatString: 0.0%
		displayFolder: AR
		lineageTag: 29cca504-7cc8-8197-47e3-6d907f7899c7

	measure 'AR 91-180 Days' = VAR me = MAX('AR Aging'[month_end]) RETURN CALCULATE(SUM('AR Aging'[open_amt]), 'AR Aging'[month_end] = me, 'AR Aging'[bucket_order] = 5)
		formatString: \$#,0
		displayFolder: AR
		lineageTag: 43f4d502-f8e4-debd-e950-c9160e99c21c

	measure 'Written Off to Date' = VAR me = MAX('AR Aging'[month_end]) RETURN CALCULATE(SUM('AR Aging'[open_amt]), 'AR Aging'[month_end] = me, 'AR Aging'[is_receivable] = FALSE())
		formatString: \$#,0
		displayFolder: AR
		lineageTag: a47b9c94-40e1-6f0a-c621-42ac186fc655

